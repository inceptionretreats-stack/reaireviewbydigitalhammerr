{
  "name": "ai-review",
  "version": "1.0.0",
  "private": true,
  "description": "AI Review by Digital Hammerr — multi-tenant review-writing assistant for local businesses",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @ai-review/db generate",
    "db:migrate": "pnpm --filter @ai-review/db migrate",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "seed": "tsx scripts/seed.ts",
    "db:dev": "node scripts/dev-db.mjs start",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "tunnel": "node scripts/tunnel.mjs",
    "ai:model": "node scripts/set-ai-model.mjs",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:down": "node scripts/dev-down.mjs",
    "dev:status": "node scripts/dev-up.mjs --status",
    "db:reencode": "node --env-file=.env scripts/db-reencode.mjs",
    "admin:create": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/create-admin.mjs"
  },
  "devDependencies": {
    "@ai-review/core": "workspace:*",
    "@ai-review/db": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.0",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.9.1",
    "jsqr": "^1.4.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
