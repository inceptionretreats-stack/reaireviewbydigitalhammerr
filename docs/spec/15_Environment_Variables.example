# App
NODE_ENV=development
APP_BASE_URL=https://review.digitalhammerr.com
API_BASE_URL=https://review.digitalhammerr.com/api/v1
SESSION_COOKIE_NAME=dh_session
SESSION_SECRET=CHANGE_ME
APP_ENCRYPTION_KEY=CHANGE_ME_32B_MIN
HASH_PEPPER=CHANGE_ME

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_review
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis / queues
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=CHANGE_ME
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
AI_MAX_OUTPUT_TOKENS=220
AI_REQUEST_TIMEOUT_MS=8000

# Razorpay
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_ANNUAL_PLAN_ID=CHANGE_ME

# Cloudflare
CLOUDFLARE_API_TOKEN=CHANGE_ME
CLOUDFLARE_ZONE_ID=CHANGE_ME
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=origin.review.digitalhammerr.com

# Object storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=ai-review-assets
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_BASE_URL=https://cdn.review.digitalhammerr.com

# Email
EMAIL_FROM=no-reply@digitalhammerr.com
SES_REGION=ap-south-1

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Product settings default bootstraps (database becomes source of truth)
FREE_AI_GENERATION_LIMIT=10
PRO_ANNUAL_PRICE_PAISE=99900
DEFAULT_TIMEZONE=Asia/Kolkata
