# Configuration contract. Mirrors docs/spec/15_Environment_Variables.example, adjusted for the
# stack recorded in docs/decisions/spec-amendments.md (ADR-AMEND-A, ADR-AMEND-B).
#
# Copy this file to .env at the repository root ONLY if there is no .env yet; never overwrite an
# existing one (its HASH_PEPPER is what local passwords were hashed with). Never put real values in
# this file: it is committed. Every variable is described in docs/operations/environment.md.
#
# Every value is validated by packages/config at process start. A CHANGE_ME left in place is
# rejected outright rather than warned about, so boot fails loudly instead of running with a
# predictable session secret.
#
# Production runs on Vercel, with PostgreSQL on Supabase and a hosted Redis. Its variables are set
# in the Vercel project, not from a file. See docs/operations/deployment-checklist.md and
# docs/operations/database-supabase.md.

NODE_ENV=development

# App
# `localhost` is fine for browser-only development, but a phone scans its own localhost. Before
# testing a real QR, use this computer's LAN address (same Wi-Fi), or run `pnpm dev:up` or
# `pnpm tunnel`, which write a public HTTPS tunnel address into both lines below. Production
# requires a stable public HTTPS origin.
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
# Optional comma-separated first-party app aliases allowed to submit authenticated forms.
# Use exact origins, e.g. https://aireview.digitalhammerr.com; no wildcards or tenant domains.
# Production requires public HTTPS origins. APP_BASE_URL still controls generated public URLs.
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_NAME=dh_session
# Required: the app refuses to start while these three are blank. SESSION_SECRET and HASH_PEPPER
# need at least 16 characters, APP_ENCRYPTION_KEY at least 32. Generate each one separately with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Once a database holds accounts, never change HASH_PEPPER (stored passwords stop verifying) or
# APP_ENCRYPTION_KEY (admin authenticator set-ups can no longer be read).
SESSION_SECRET=
APP_ENCRYPTION_KEY=
HASH_PEPPER=
# Optional Google Identity Services Web OAuth client ID; enables Continue with Google for vendors.
# This is a public client ID, not a client secret. See docs/operations/google-sign-in.md.
GOOGLE_CLIENT_ID=

# Database
# Local development uses Postgres. Production uses the Digital Hammerr Supabase Postgres project;
# its verified-TLS setup is documented in docs/operations/database-supabase.md.
# The value below matches the bundled local database that `pnpm db:dev` and `pnpm dev:up` start on
# Windows (scripts/dev/dev-db.mjs): user postgres, password postgres, port 5432, database ai_review.
# These are fixed development defaults, not secrets. On macOS/Linux use your own PostgreSQL 17+ on
# localhost. Keep this pointing at a local database you are allowed to overwrite: dev:up (unless
# DIRECT_DATABASE_URL is set), the migrate command, the seed and the test suites all write to
# whatever it names. On Vercel the app's DATABASE_URL is Supabase's transaction pooler (6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_review
# Optional migration-only connection. Leave this blank in your local .env: when it is set,
# `pnpm dev:up` and the migration runner apply migrations to it INSTEAD of DATABASE_URL, on every
# dev:up start. Production migrations use Supabase's session pooler (5432) from a separate,
# git-ignored env file (docs/operations/database-supabase.md), never from .env; take the exact
# host/user from the project's Connect dialog there and do not guess the hostname.
DIRECT_DATABASE_URL=
DATABASE_POOL_MIN=2
# 2 web containers + 1 worker x 20 = 60 connections. Confirm this fits the instance tier.
# On Vercel with Supabase start with DATABASE_POOL_MIN=0 and DATABASE_POOL_MAX=1.
DATABASE_POOL_MAX=20
# TLS defaults to disabled for localhost and required for remote hosts. For verified TLS use
# DATABASE_SSL=verify-full plus the provider's PEM CA in DATABASE_SSL_ROOT_CERT.
# DATABASE_SSL=require
# DATABASE_SSL_ROOT_CERT=

# Redis / queues
REDIS_URL=redis://localhost:6379
# Multiplies every rate-limit allowance (default 1 = the calibrated production policy). Raise it
# only for a test environment, where automated end-to-end runs would otherwise trip the limits.
# RATE_LIMIT_MULTIPLIER=1

# OpenAI
# Model and prompt are admin-versioned in ai_prompt_versions (ADR-006); these only bootstrap.
# Luna was checked on 11 Sep 2026 at $0.20/M in, $1.20/M out — about 4.6% of revenue at scale.
# Prices change; re-verify before any cost decision.
# Terra is 10x. Never wire it as an automatic failover; see docs/decisions/spec-amendments.md.
# Leave empty for local/CI: the deterministic stub provider is selected instead. Required in
# production, where an empty value is a boot failure rather than canned drafts to real customers.
OPENAI_API_KEY=

# Anthropic. Set this, OPENAI_API_KEY or GEMINI_API_KEY — whichever is present decides the
# provider; precedence when several are set is Anthropic, then OpenAI, then Gemini. Production
# refuses to boot with none of the three, because the alternative is the stub serving canned
# drafts to real customers.
ANTHROPIC_API_KEY=

# Google Gemini, via a Google AI Studio key (https://aistudio.google.com/apikey). The only one
# of the three with a free tier: Flash-class models cost nothing per token on it, which is how
# a demo runs before a card exists. Two things the operator is choosing with it — Google's
# pricing page says free-tier content is "used to improve our products", and the free tier's
# per-minute and per-day limits (visible only in AI Studio) arrive as 429s on a busy day.
# Pair it with a model that accepts thinkingLevel "minimal" (gemini-3.5-flash-lite) and the
# default reasoning effort "none": on Gemini, thinking tokens count against max_output_tokens.
GEMINI_API_KEY=

# Overrides the model the seed writes into ai_prompt_versions. Blank means the prompt
# template's default, gpt-5.6-luna — a real OpenAI model, verified against the live catalogue
# on 11 Sep 2026 at $0.20/$1.20 per million tokens (the price the unit economics assume).
#
# Switching to OpenAI: set OPENAI_API_KEY, leave ANTHROPIC_API_KEY blank, run the seed once
# (`node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/db/seed.ts --force`) so the
# current prompt version is ACTIVE with this model, then restart the server — keys are read at
# boot, the prompt row per request. To change only the model later, without a reseed:
#   pnpm ai:model gpt-5.6-luna --effort none
# For an Anthropic model leave the effort empty (`--effort ''`): the field does not exist there,
# and the OpenAI adapter sends it only when non-blank.
# Gemini: gemini-3.5-flash-lite (free tier, accepts minimal thinking); OpenAI: gpt-5.6-luna.
AI_DEFAULT_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT_OVERRIDE=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
AI_MAX_OUTPUT_TOKENS=220
AI_REQUEST_TIMEOUT_MS=8000

# Razorpay — online upgrade to Pro (SUB-01, CHANGE-004). Optional: without all three of the
# key id, key secret and webhook secret the Upgrade button says payment is not set up and an
# admin activates Pro from /admin instead. Test-mode keys (rzp_test_…) work end to end with
# Razorpay's test cards. Register the webhook at <APP_BASE_URL>/api/v1/webhooks/razorpay for
# the events payment.captured, order.paid, payment.failed, refund.created, refund.processed
# and refund.failed (AMENDMENT-029), with the secret below. Refunds and reconciliation from
# /admin/payments need the key id and secret too.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ANNUAL_PLAN_ID=
# Orders API origin override for a local rehearsal against a fake endpoint. Never set in
# production.
# RAZORPAY_BASE_URL=http://127.0.0.1:4545/v1

# Cloudflare — WAF/CDN, R2, and Cloudflare for SaaS custom hostnames. Not required until E11;
# validated, but no code reads them yet, so custom domains are not available.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=

# Object storage — Cloudflare R2 via the S3-compatible API. Only S3_PUBLIC_BASE_URL is read today
# (the host for business logo and cover images); S3_BUCKET must be non-empty to pass validation.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=ai-review-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Email
EMAIL_FROM=no-reply@digitalhammerr.com
SES_REGION=ap-south-1

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Plans. The three plan variables below are validated but NOT read by any code. The Free and Pro
# allowances and the Pro price come only from platform_settings, edited at /admin/settings, with
# fallback defaults in packages/core/src/platform/settings.ts (PLATFORM_SETTING_DEFAULTS).
# Changing them here changes nothing (ADMIN-04).
FREE_AI_GENERATION_LIMIT=10
PRO_ANNUAL_GENERATION_LIMIT=2000
PRO_ANNUAL_PRICE_PAISE=99900
DEFAULT_TIMEZONE=Asia/Kolkata

# Platform admin (E12 subset, CHANGE-004, AMENDMENT-027). The seed's demo-admin@example.com has
# no usable password unless SEED_ADMIN_PASSWORD is set. The operator's tool for a real account is
#   pnpm admin:create --email you@example.com --password '…' --name 'Your name' --reason 'why'
# which writes an audited user.role.change. While ADMIN_MFA_REQUIRED is true (the default), every
# admin is made to enrol an authenticator app at first sign-in; `--totp-secret <base32>` pre-arms
# one for break-glass and E2E.
# SEED_ADMIN_PASSWORD=
# The name shown in the authenticator app next to the code.
MFA_ISSUER=Ai Review by Digital Hammerr
# Whether an admin must pass the authenticator before reaching /admin. The spec makes it
# mandatory; 'false' runs the admin area password-only (the owner's call, 16 Sept 2026) and
# also skips the fresh-code step-up on refunds and settings. Enrolment stays available.
ADMIN_MFA_REQUIRED=true

# Email (AMENDMENT-029). Resend API key; without it, development prints emails to the console
# and production sends nothing (receipts show "not sent" in /admin/payments).
RESEND_API_KEY=

# Vercel Cron (AMENDMENT-029). Required in production — the app refuses to boot without it;
# optional locally. Vercel sends it as "Authorization: Bearer <value>" to the /api/cron/* routes.
# Generate it the same way as the secrets above:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# How long user activity rows are kept (AMENDMENT-028); the cron purges older ones.
ACTIVITY_RETENTION_DAYS=180
